{#
/**
 * @file
 * Theme override for a "Service" node in teaser view mode.
 *
 * Matched automatically via Drupal's content-type + view-mode suggestion
 * (node--service--teaser.html.twig) — no conditional needed. The "01, 02..."
 * index comes from `service_index`, set in horizon_theme_preprocess_node()
 * — a real count of the rendered results, not a CSS trick.
 *
 * Icons are inline SVG (stroke = currentColor, styled orange via CSS) —
 * matches the reference's line-icon style without loading an icon font.
 */
#}
{% set icons = {
  compass: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z" stroke-linejoin="round"/></svg>',
  palette: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3a9 9 0 100 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.4-.3-.4-.5-.9-.5-1.4 0-1.1.9-2 2-2H17a4 4 0 004-4c0-4-4-7-9-7z"/><circle cx="7.5" cy="10.5" r="1" fill="currentColor" stroke="none"/><circle cx="10.5" cy="7" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="7.5" r="1" fill="currentColor" stroke="none"/></svg>',
  layout: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="1.5"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="9" x2="9" y2="20"/></svg>',
  code: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 8 4 12 9 16"/><polyline points="15 8 20 12 15 16"/></svg>',
  camera: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="3" y="7" width="13" height="10" rx="1.5"/><path d="M16 10l5-2.5v9L16 14z"/></svg>',
  growth: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 6"/><polyline points="15 6 21 6 21 12"/></svg>',
} %}
{% set icon_key = content.field_service_icon.0|render|trim %}

<article{{ attributes.addClass('service-item') }}>
  <div class="item-top">
    <span class="service-item__icon" aria-hidden="true">{{ (icons[icon_key]|default(icons.compass))|raw }}</span>
    <span class="index">{{ '%02d'|format(service_index) }}</span>
  </div>

  {{ title_prefix }}
  {% if label %}
    <h4{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h4>
  {% endif %}
  {{ title_suffix }}

  {{ content.field_body }}

  <a href="{{ url }}" class="read-more">
    {{ 'Learn More'|t }}
    <span class="read-more__icon" aria-hidden="true">&rarr;</span>
  </a>
</article>
