{#
/**
 * @file
 * Theme override for the "Services" view's unformatted row list.
 *
 * Matched automatically via Drupal's view-name theme suggestion
 * (views-view-unformatted--services.html.twig) — no conditional needed.
 * Adds a .services-grid wrapper so the CSS grid has a stable selector
 * (Views doesn't otherwise wrap rows in a classed container).
 *
 * Available variables: see core's views-view-unformatted.html.twig.
 */
#}
{% if title %}
  <h3>{{ title }}</h3>
{% endif %}
<div class="services-grid">
  {% for row in rows %}
    {%
      set row_classes = [
        default_row_class ? 'views-row',
      ]
    %}
    <div{{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
