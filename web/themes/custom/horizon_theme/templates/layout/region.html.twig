{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessRegion()
 */
#}
{#
  Drupal core's default region.html.twig adds `region region-{name}` classes
  here (in the template, not in preprocess) — restoring that so regions with
  more than one block (e.g. `footer`) have a stable class to hang CSS Grid
  layout off of.
#}
{% set classes = ['region', 'region-' ~ region|clean_class] %}
{% if content %}
  <div{{ attributes.addClass(classes) }}>
    {{ content }}
  </div>
{% endif %}
