{#
/**
 * @file
 * Theme override for the "Nav Share Breadcrumbs" custom block bundle.
 *
 * `section` is the raw block_content entity, read directly for
 * `field_title` and looped for `field_share_links` (Social Link
 * paragraphs: field_icon media + field_link URL) — same technique as the
 * Contact Section's info items.
 *
 * If an editor hasn't uploaded a `field_icon` media image yet, this falls
 * back to a matching inline SVG keyed by the link's title (e.g.
 * "facebook", "pinterest") — same fallback pattern as the Team section's
 * social links and the Editorial cards' icons.
 *
 * `content.breadcrumb_links` is NOT a field — it's Drupal's own
 * breadcrumb for the current page, attached in
 * horizon_theme_preprocess_block() (same pattern as the Contact Section's
 * webform), since it isn't editable content.
 */
#}
{% set section = content['#block_content'] %}
{% set social_icons = {
  facebook: '<svg viewBox="0 0 32 32"><path fill="#fff" d="M28 16c0-6.627-5.373-12-12-12S4 9.373 4 16c0 5.628 3.875 10.35 9.101 11.647v-7.98h-2.474V16H13.1v-1.58c0-4.085 1.849-5.978 5.859-5.978.76 0 2.072.15 2.608.298v3.325c-.283-.03-.775-.045-1.386-.045-1.967 0-2.728.745-2.728 2.683V16h3.92l-.673 3.667h-3.247v8.245C23.395 27.195 28 22.135 28 16"/></svg>',
  pinterest: '<svg viewBox="0 0 32 32"><path fill="#fff" d="M15.995 4C9.361 4 4 9.37 4 15.995c0 5.084 3.16 9.428 7.622 11.176-.109-.948-.198-2.41.039-3.446.217-.938 1.402-5.963 1.402-5.963s-.356-.72-.356-1.777c0-1.668.968-2.912 2.172-2.912 1.027 0 1.52.77 1.52 1.688 0 1.027-.65 2.567-.996 3.998-.287 1.195.602 2.172 1.777 2.172 2.132 0 3.771-2.25 3.771-5.489 0-2.873-2.063-4.877-5.015-4.877-3.416 0-5.42 2.557-5.42 5.203 0 1.027.395 2.132.888 2.735a.36.36 0 0 1 .08.345c-.09.375-.297 1.195-.336 1.363-.05.217-.178.266-.405.158-1.481-.711-2.409-2.903-2.409-4.66 0-3.781 2.745-7.257 7.928-7.257 4.156 0 7.394 2.962 7.394 6.931 0 4.137-2.606 7.464-6.22 7.464-1.214 0-2.36-.632-2.744-1.383l-.75 2.854c-.267 1.046-.998 2.35-1.491 3.149a12 12 0 0 0 3.554.533C22.629 28 28 22.63 28 16.005 27.99 9.37 22.62 4 15.995 4"/></svg>',
  twitter: '<svg viewBox="0 0 32 32"><path fill="#fff" d="M28 8.557a10 10 0 0 1-2.828.775 4.93 4.93 0 0 0 2.166-2.725 9.7 9.7 0 0 1-3.13 1.194 4.92 4.92 0 0 0-3.593-1.55 4.924 4.924 0 0 0-4.794 6.049c-4.09-.21-7.72-2.17-10.15-5.15a4.94 4.94 0 0 0-.665 2.477c0 1.71.87 3.214 2.19 4.1a5 5 0 0 1-2.23-.616v.06c0 2.39 1.7 4.38 3.952 4.83-.414.115-.85.174-1.297.174q-.476-.001-.928-.086a4.935 4.935 0 0 0 4.6 3.42 9.9 9.9 0 0 1-6.114 2.107q-.597 0-1.175-.068a13.95 13.95 0 0 0 7.55 2.213c9.056 0 14.01-7.507 14.01-14.013q0-.32-.015-.637c.96-.695 1.795-1.56 2.455-2.55z"/></svg>',
  linkedin: '<svg viewBox="0 0 32 32"><path fill="#fff" d="M6.227 12.61h4.19v13.48h-4.19zm2.095-6.7a2.43 2.43 0 0 1 0 4.86c-1.344 0-2.428-1.09-2.428-2.43s1.084-2.43 2.428-2.43m4.72 6.7h4.02v1.84h.058c.56-1.058 1.927-2.176 3.965-2.176 4.238 0 5.02 2.792 5.02 6.42v7.395h-4.183v-6.56c0-1.564-.03-3.574-2.178-3.574-2.18 0-2.514 1.7-2.514 3.46v6.668h-4.187z"/></svg>',
} %}
{% set social_links = [] %}
{% for item in section.field_share_links %}
  {% set link_item = item.entity %}
  {% if link_item %}
    {% set has_icon = link_item.field_icon.target_id %}
    {% set icon = link_item.field_icon.entity %}
    {% set url = link_item.field_link.0 %}
    {% set platform_key = url ? url.title|lower : '' %}
    {% set social_links = social_links|merge([{
      icon_url: has_icon ? file_url(icon.field_media_image.entity.uri.value) : '',
      icon_alt: has_icon ? icon.field_media_image.0.alt : '',
      icon_svg: has_icon ? '' : (social_icons[platform_key]|default('')),
      url: url ? url.getUrl().toString() : '#',
      label: url ? url.title : '',
    }]) %}
  {% endif %}
{% endfor %}

{% include '@horizon_theme/components/03-organisms/nav-share-breadcrumbs/nav-share-breadcrumbs.html.twig' with {
  attributes: attributes,
  title_suffix: title_suffix,
  share_label: section.field_title.value,
  social_links: social_links,
  breadcrumb_links: content.breadcrumb_links,
} only %}
