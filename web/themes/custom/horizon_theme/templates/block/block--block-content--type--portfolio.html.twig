{#
/**
 * @file
 * Theme override for the "Portfolio" custom block bundle.
 *
 * Matched automatically via Drupal's block theme suggestion
 * (block--block-content--type--portfolio.html.twig, since the block_content
 * bundle is "portfolio") — no conditional needed.
 *
 * This block only holds the section title/intro (field_title,
 * field_description) — the actual portfolio grid comes from the separate
 * "Portfolio" View block placed right after this one in the same region,
 * since the grid items are `portfolio_item` nodes, not paragraphs.
 *
 * `section` is the raw block_content entity (content['#block_content']),
 * read directly — same technique as the other section titles (Team,
 * Testimonials, Pricing, FAQ). `field_description` is a formatted-text
 * field (has a text format), so `content.field_description` is used
 * instead of `.value` to run it through Drupal's text-format filter.
 */
#}
{% set section = content['#block_content'] %}

<div{{ attributes }}>
  <div class="container section-title">
    <h2 class="portfolio-title">{{ section.field_title.value }}</h2>
    <div class="portfolio-intro">{{ content.field_description }}</div>
  </div>
</div>
