{#
/**
 * @file
 * Theme override for the "Team Section" custom block bundle.
 *
 * Matched automatically via Drupal's block theme suggestion
 * (block--block-content--type--team-section.html.twig, since the
 * block_content bundle is "team_section") — no conditional needed.
 *
 * `section` is the raw block_content entity (content['#block_content']),
 * and each Team Member paragraph in `field_team_members` is looped
 * directly here (via `item.entity`) instead of going through
 * field--field-team-members.html.twig + paragraph--team-member.html.twig —
 * same technique as the Contact Section's info items.
 */
#}
{% set section = content['#block_content'] %}
{% set members = section.field_team_members %}
{% set social_icons = {
  twitter: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.1 10.2 21 3h-2l-5.9 6.3L8.7 3H3l7.2 10.4L3 21h2l6.3-6.7L16.6 21H22z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2 2 0 11-.02 4 2 2 0 01.02-4zM3 9h4v12H3zM10 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4z"/></svg>',
  dribbble: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M4 9.5c4 1.3 9 1.3 15.5-.5M3.5 15c5-1.7 10-2 16.3 1M9 3.3c3 4 4.5 9 4.3 17.4"/></svg>',
  behance: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="8" width="9" height="8" rx="2"/><path d="M2 11h6M14 16c0-4 2-8 5-8s5 4 5 8-2 0-5 0-5 0-5 0z"/><path d="M14 8h6"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  github: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-3.16 19.5c.5.1.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03a9.6 9.6 0 015 0c1.9-1.3 2.74-1.03 2.74-1.03.56 1.37.21 2.39.1 2.64.65.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0012 2z"/></svg>',
} %}

<div{{ attributes }}>

  <div class="container section-title">
    <h2 class="team-title">{{ section.field_member_section_title.value }}</h2>
    <p class="team-intro">{{ section.field_member_section_intro.value }}</p>
  </div>

  <div class="container">
    <div class="team-grid">
      {% for item in members %}
        {% set member = item.entity %}
        {% set member_media = member.field_member_image.entity %}
        <article class="team-grid__item team-member">
          <div class="member-photo">
            {% if member.field_member_image.target_id %}
              <img
                src="{{ file_url(member_media.field_media_image.entity.uri.value) }}"
                alt="{{ member_media.field_media_image.0.alt }}"
                loading="lazy"
              >
            {% endif %}
          </div>
          <div class="member-info">
            <h4>{{ member.field_member_name.value }}</h4>
            <span class="role">{{ member.field_member_role.value }}</span>
            <div class="socials">
              {% for link in member.field_member_social %}
                {% set key = link.title|lower %}
                <a href="{{ link.getUrl().toString() }}" aria-label="{{ key|capitalize }} profile">
                  {{ (social_icons[key]|default(social_icons.twitter))|raw }}
                </a>
              {% endfor %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>

</div>
