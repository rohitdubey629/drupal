{#
/**
 * @file
 * Theme override for the "Contact Section" custom block bundle.
 *
 * Matched automatically via Drupal's block theme suggestion
 * (block--block-content--type--contact-section.html.twig, since the
 * block_content bundle is "contact_section") — no conditional needed.
 *
 * content.contact_form is not a field — it's the site-wide contact form,
 * attached in horizon_theme_preprocess_block() since a form isn't content
 * that belongs in a field.
 *
 * `field_contact_info_items` (Paragraph reference) is looped directly here
 * instead of going through a separate paragraph--contact-info-item.html.twig
 * + field--field-contact-info-items.html.twig pair — each info item is
 * simple enough (icon + title + value, no image/link) that a nested loop
 * in this one file is simpler than three files for one small paragraph.
 */
#}
{% set section = content['#block_content'] %}
{% set title = section.field_contact_section_title.value %}
{% set intro = section.field_contact_section_intro.value %}
{% set info_items = section.field_contact_info_items %}
{% set icons = {
  location: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-7.1 7-12a7 7 0 10-14 0c0 4.9 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>',
  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h3l2 5-2.5 1.5a11 11 0 005 5L15 12l5 2v3a2 2 0 01-2 2A16 16 0 014 6a2 2 0 012-2z"/></svg>',
  email: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
} %}

<div{{ attributes }}>

  <div class="container section-title">
    <h2 class="contact-title">{{ title }}</h2>
    <p class="contact-section-intro">{{ intro }}</p>
  </div>

  <div class="container">
    <div class="contact-inner">

      <div class="contact-info">
        {% for item in info_items %}
          {% set info = item.entity %}
          {% set icon_key = info.field_info_icon.value|trim %}
          <div class="info-item">
            <span class="info-item__icon" aria-hidden="true">{{ (icons[icon_key]|default(icons.location))|raw }}</span>
            <div class="info-text">
              <h5>{{ info.field_info_title.value }}</h5>
              <p>{{ info.field_info_value.value }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="contact-form-wrap">
        {{ content.contact_form }}
      </div>

    </div>
  </div>

</div>
