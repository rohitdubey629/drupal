{#
/**
 * @file
 * Theme override for the main navigation menu.
 *
 * Matched automatically via Drupal's menu theme suggestion
 * (menu--main.html.twig, since menu_name == "main") — no conditional needed.
 *
 * Available variables: see menu.html.twig.
 *
 * Links are built as plain <a> tags instead of via the `link()` Twig
 * function: `link()` marks a link "is-active" whenever its resolved ROUTE
 * matches the current route, ignoring the URL fragment — and since every
 * nav item here (About, Services, Team...) is really just `/#section` on
 * the same front-page route, `link()` marked all of them active at once.
 * A real "current section" highlight instead comes from a scroll-spy
 * IntersectionObserver in script.js, which toggles `.is-active` on
 * whichever link's href matches the section currently in view.
 */
#}
{% import _self as menus %}

<button type="button" class="site-header__nav-toggle" aria-expanded="false" aria-controls="primary-menu">
  <span class="visually-hidden">{{ 'Menu'|t }}</span>
  <span class="site-header__nav-toggle-bar"></span>
  <span class="site-header__nav-toggle-bar"></span>
  <span class="site-header__nav-toggle-bar"></span>
</button>

{{ menus.menu_links(items, attributes.addClass('primary-menu').setAttribute('id', 'primary-menu'), 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes }}>
    {% else %}
      <ul class="primary-menu__submenu">
    {% endif %}
    {% for item in items %}
      <li{{ item.attributes.addClass(item.below ? 'menu-item--has-children') }}>
        <div class="primary-menu__row">
          <a href="{{ item.url }}">{{ item.title }}</a>
          {% if item.below %}
            <button type="button" class="primary-menu__toggle" aria-expanded="false" aria-label="{{ 'Toggle submenu'|t }}"></button>
          {% endif %}
        </div>
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
