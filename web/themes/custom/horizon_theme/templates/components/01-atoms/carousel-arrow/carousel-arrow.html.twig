{# this is the presentational component file for the carousel arrow atom #}
{#
/**
 * @file
 * Presentational "Carousel Arrow" atom — prev/next chevron button.
 *
 * The chevron SVG is identical across the Content Hub Featured and
 * Content Hub Trending carousels; only the wrapper's classes (BEM block
 * name + js hook) and aria-label translation differ per caller, so those
 * are passed in rather than hardcoded here.
 *
 * Variables:
 * - direction: 'prev' | 'next' — picks the chevron path and default
 *   aria-label ("Previous" / "Next").
 * - extra_class: additional classes (string), e.g.
 *   "content-hub-trending_arrow js-trending-prev".
 */
#}
<button type="button" class="{{ extra_class }}" aria-label="{{ direction == 'prev' ? 'Previous'|t : 'Next'|t }}">
  {% if direction == 'prev' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
  {% else %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
  {% endif %}
</button>
